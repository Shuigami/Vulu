# Copy to .env and fill in. Never commit .env.

# Production only (docker-compose.yml): public domain, and the database password
# (letters and digits only, it goes into a URL: `openssl rand -hex 24`).
# DATABASE_URL and BETTER_AUTH_URL below are then set by the compose file.
VULU_DOMAIN=
POSTGRES_PASSWORD=

# Grafana stats dashboard, production only and opt-in (deploy/grafana):
# COMPOSE_PROFILES=grafana starts it. The admin user is "admin". GRAFANA_DB_PASSWORD is the
# password of the read-only grafana_reader role, set by deploy/grafana/readonly.sql.
# COMPOSE_PROFILES=grafana
GRAFANA_DOMAIN=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=

# Local PostgreSQL started by `pnpm db:up` (docker-compose.dev.yml)
DATABASE_URL=postgres://vulu:vulu@localhost:5432/vulu

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app (must match the browser origin)
BETTER_AUTH_URL=http://localhost:5173

# Outgoing e-mail (password reset), optional in development: without SMTP_URL the reset
# link is printed in the app's console. URL-encode special characters in the password.
#   e.g. smtps://user:password@smtp-relay.brevo.com:465 (netcup blocks 465/587: use smtp://...:2525)
SMTP_URL=
# Sender, e.g. Vulu <noreply@example.com> (must be allowed by the SMTP provider)
MAIL_FROM=

# OAuth sign-in, optional: a button only shows up when both values are set.
# Google: https://console.cloud.google.com/apis/credentials
#   redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
#   callback URL: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Metadata providers (used by the worker only). AniList and Open Library need no key.
# TMDB: v3 API key or v4 read access token, https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# AniList OAuth client, not used yet (imports read public lists)
ANILIST_CLIENT_ID=
# Trakt application, for Trakt imports: https://trakt.tv/oauth/applications
#   The client id reads public profiles. With the secret, private profiles sign in with Trakt:
#   set the app's redirect URI to <origin>/import/trakt (http://localhost:5173/import/trakt in dev).
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
