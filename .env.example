# Copy to .env and fill in. Never commit .env.

# Local PostgreSQL started by `pnpm db:up` (docker-compose.dev.yml)
DATABASE_URL=postgres://vulu:vulu@localhost:5432/vulu

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Metadata providers (used by the worker only)
TMDB_API_KEY=
ANILIST_CLIENT_ID=
