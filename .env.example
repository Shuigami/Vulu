# Copy to .env and fill in. Never commit .env.

# Local PostgreSQL started by `pnpm db:up` (docker-compose.dev.yml)
DATABASE_URL=postgres://vulu:vulu@localhost:5432/vulu

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app (must match the browser origin)
BETTER_AUTH_URL=http://localhost:5173

# OAuth sign-in, optional: a button only shows up when both values are set.
# Google: https://console.cloud.google.com/apis/credentials
#   redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
#   callback URL: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Metadata providers (used by the worker only). AniList and Open Library need no key.
# TMDB: v3 API key or v4 read access token, https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# AniList OAuth client, not used yet (imports read public lists)
ANILIST_CLIENT_ID=
# Trakt application client id, for Trakt imports: https://trakt.tv/oauth/applications
#   (redirect URI: urn:ietf:wg:oauth:2.0:oob, only the client id is used)
TRAKT_CLIENT_ID=
