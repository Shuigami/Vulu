			"id": 8,
			"datasource": {
				"type": "grafana-postgresql-datasource",
				"uid": "vulu"
			},
			"type": "timeseries",
			"title": "Ajouts à la bibliothèque par jour",
			"gridPos": {
				"x": 12,
				"y": 4,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"format": "time_series",
					"rawQuery": true,
					"editorMode": "code",
					"rawSql": "SELECT date_trunc('day', e.created_at AT TIME ZONE 'Europe/Paris') AT TIME ZONE 'Europe/Paris' AS time, m.type::text AS metric, count(*) AS value FROM library_entries e JOIN media m ON m.id = e.media_id WHERE $__timeFilter(e.created_at) GROUP BY 1, 2 ORDER BY 1"
				}
			],
			"fieldConfig": {
				"defaults": {
					"custom": {
						"drawStyle": "bars",
						"fillOpacity": 80,
						"stacking": {
							"mode": "normal"
						}
					}
				},
				"overrides": []
			}
		},
