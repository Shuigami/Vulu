					"refId": "A",
					"format": "table",
					"rawQuery": true,
					"editorMode": "code",
					"rawSql": "SELECT 'import ' || source AS quoi, status::text AS état, count(*) AS nombre FROM import_jobs GROUP BY 1, 2 UNION ALL SELECT 'intégration ' || kind, CASE WHEN enabled THEN 'active' ELSE 'désactivée' END, count(*) FROM integrations GROUP BY 1, 2 ORDER BY 1, 2"
