			"targets": [
				{
					"refId": "A",
					"format": "time_series",
					"rawQuery": true,
					"editorMode": "code",
					"rawSql": "SELECT date_trunc('day', created_at AT TIME ZONE 'Europe/Paris') AT TIME ZONE 'Europe/Paris' AS time, count(*) AS \"inscriptions\" FROM users WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
